# Force demo crawl + DemoProvider (no network / no API keys)
AEO_DEMO_MODE=false

# SQLite database URL
AEO_DATABASE_URL=sqlite:///./aeo_mvp.db

# HTTP API authentication (fail-closed). Required for all routes except GET /health.
# Clients must send: Authorization: Bearer <AEO_API_KEY>
# AEO_API_KEY=

# Deployment mode (default production). Unauthenticated bypass is ignored unless
# this is development|dev|test|local AND AEO_ALLOW_UNAUTHENTICATED=true.
# AEO_ENVIRONMENT=production
# AEO_ALLOW_UNAUTHENTICATED=false

# Visibility provider: auto | demo | openai_compatible | digitalocean_web_search
# AEO_VISIBILITY_PROVIDER=auto

# Optional live OpenAI-compatible visibility provider (llm_mention only)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# DigitalOcean Inference — first retrieval-enabled ai_search_visibility provider
# Prefer DO_MODEL_ACCESS_KEY; MODEL_ACCESS_KEY accepted as DO docs fallback.
# DO_MODEL_ACCESS_KEY=
# MODEL_ACCESS_KEY=
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# DO_INFERENCE_MODEL=openai-gpt-4o
# DO_WEB_SEARCH_MAX_USES=3
# DO_WEB_SEARCH_MAX_RESULTS=5
# DO_INFERENCE_TIMEOUT_S=60
# Optional live pytest gate (default off):
# AEO_LIVE_RETRIEVAL_TEST=false

# Crawl caps (cannot exceed blueprint maxima)
AEO_CRAWL_MAX_PAGES=25
AEO_CRAWL_MAX_DEPTH=2
AEO_CRAWL_TIMEOUT_S=5

# Optional site-understanding LLM (default off; deterministic path always used first)
# AEO_SITE_UNDERSTANDING_LLM=false

# Query discovery selection size (Phase 3 default ~20; clamped 8–30)
# AEO_QUERY_TOP_N=20

# Paid DigitalOcean web_search opt-in (ADR-026). Default off.
# true opts into paid DO retrieval; does NOT bypass readiness or credential checks
# (still requires ready QuerySet + DO_MODEL_ACCESS_KEY / MODEL_ACCESS_KEY).
# Request options.paid_retrieval_opt_in cannot enable spend when this is false.
AEO_PAID_RETRIEVAL_OPT_IN=false

# Optional Perplexity Sonar (stub — live path not implemented; do not fake metrics)
# PERPLEXITY_API_KEY=
