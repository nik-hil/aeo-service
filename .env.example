# Only LLM credential (DigitalOcean Inference / Responses API)
# AEO_LLM_API_KEY=
AEO_LLM_BASE_URL=https://inference.do-ai.run/v1
AEO_LLM_MODEL=openai-gpt-4o
# AEO_LLM_TIMEOUT_S=60
# AEO_WEB_SEARCH_MAX_USES=3
# AEO_WEB_SEARCH_MAX_RESULTS=5

# Service auth (separate from LLM). Optional for local Gradio.
# AEO_API_KEY=

# Query selection size (~15–20; clamped 8–25)
# AEO_QUERY_TOP_N=18

# Optional live pytest gate (default off)
# AEO_LIVE_RETRIEVAL_TEST=false
